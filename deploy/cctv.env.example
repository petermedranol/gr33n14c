# Greeniac CCTV recorder configuration.
# Install to /etc/greeniac/cctv.env  (owner root:root, mode 600 — it holds credentials).

# Base folder for recordings (inside the mounted USB disk).
CCTV_ROOT=/mnt/cctv/greeniac/cctv

# Segment length in seconds (600 = 10 min clock-aligned chunks).
SEGMENT_SECONDS=600

# Retention: keep deleting the oldest files until at least this many GB are free.
MIN_FREE_GB=50

# ffmpeg socket-timeout flag so a stalled stream fails fast and systemd restarts it.
# ffmpeg 7.x RTSP: -timeout is microseconds. Leave empty to disable.
RTSP_TIMEOUT_OPT=-timeout 15000000

# Per-camera RTSP URLs. Variable name = <CAMERA>_RTSP_URL (upper-case).
# subtype=0 main stream, subtype=1 sub-stream.
GARAGE_RTSP_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/cam/realmonitor?channel=1&subtype=0
# Add one line per camera, e.g.:
# PATIOPAPAS_RTSP_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/h264/ch1/sub/av_stream
