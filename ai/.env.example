# Greeniac AI services config — copy to ".env" and fill in your values.
# The real .env is gitignored (it holds camera passwords and tokens).

# ─── Person detector (detect.py = Garage) ───
# Garage camera RTSP (sub-stream is fine; the detector downscales internally).
RTSP_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/cam/realmonitor?channel=1&subtype=1

# Telegram bot (create one with @BotFather).
TELEGRAM_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Detection settings
MODEL=yolo11m.pt
CONF=0.5
COOLDOWN_SECONDS=60
FPS=5
WIDTH=1280
IMGSZ=1280
CONFIRM_FRAMES=4
EVENT_DIR=events

# Push detections to the Pi dashboard gallery
PI_EVENTS_URL=http://PI_IP:8000/api/cctv/events/ingest
PI_INGEST_TOKEN=generate-a-long-random-secret

# ─── Live gateway (gateway.py) — PC transcodes camera streams to HLS ───
GATEWAY_RTSP=rtsp://USER:PASSWORD@CAMERA_IP:554/cam/realmonitor?channel=1&subtype=0
GATEWAY_PORT=8090
GATEWAY_TOKEN=generate-a-long-random-secret
GATEWAY_WIDTH=1280
GATEWAY_BITRATE=2500k

# Extra cameras served by the same gateway (comma-separated). Each needs a
# GATEWAY_RTSP_<NAME> (+ optional GATEWAY_WIDTH_<NAME>/GATEWAY_BITRATE_<NAME>).
GATEWAY_CAMERAS=patiopapas
GATEWAY_RTSP_PATIOPAPAS=rtsp://USER:PASSWORD@CAMERA_IP:554/h264/ch1/sub/av_stream
GATEWAY_WIDTH_PATIOPAPAS=800
GATEWAY_BITRATE_PATIOPAPAS=900k

# ─── Transcoder (transcoder.py) — web copies of recordings ───
# Optional per-camera override (defaults to WEB_BITRATE for all).
WEB_BITRATE_PATIOPAPAS=500k

# ─── Extra-camera person detector (detect_patiopapas.py) ───
DETECT_RTSP_PATIOPAPAS=rtsp://USER:PASSWORD@CAMERA_IP:554/h264/ch1/sub/av_stream

# ─── Bark detector (bark.py = Garage; bark_patiopapas.py = Patio) ───
# Garage audio (its sub-stream carries audio).
BARK_RTSP=rtsp://USER:PASSWORD@CAMERA_IP:554/h264/ch1/sub/av_stream
# Patio audio: main stream (bark pulls only the audio track).
BARK_RTSP_PATIOPAPAS=rtsp://USER:PASSWORD@CAMERA_IP:554/h264/ch1/main/av_stream
BARK_LOG_CONF=0.15
BARK_CONFIRM=2
BARK_COOLDOWN=10
FUSION_WINDOW_SECONDS=20
PI_BARK_URL=http://PI_IP:8000/api/cctv/bark/ingest
